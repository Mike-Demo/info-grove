# DXS Cloud — environment template
# Copy to .env and fill in from your Supabase project settings
# (Project Settings -> API). These are the publishable (client-side)
# credentials; Row Level Security on the tables is the access control.
# Never put a service-role key or database password in this file.

SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
